<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>WinSidebar</AssemblyName>
    <RootNamespace>WinSidebar</RootNamespace>
    <NeutralLanguage>en-US</NeutralLanguage>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Product>WinSidebar</Product>
    <Description>Windows sidebar for window switching, shortcuts, and text snippets.</Description>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <ApplicationIcon>assets/WinSidebar.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/WinSidebar.cs" />
    <Compile Include="src/ShortcutConfig.cs" />
    <Compile Include="src/WindowManagement.cs" />
    <Compile Include="src/Localization.cs" />
    <Compile Include="src/FirstRunLanguageDialog.cs" />
    <Compile Include="src/SnippetStore.cs" />
    <Compile Include="src/SnippetEditor.cs" />
    <Compile Include="src/TextInjection.cs" />
    <EmbeddedResource Include="i18n/catalog.json" LogicalName="WinSidebar.i18n.catalog.json" />
    <EmbeddedResource Include="i18n/es-ES.json" LogicalName="WinSidebar.i18n.es-ES.json" />
    <EmbeddedResource Include="i18n/ru-RU.json" LogicalName="WinSidebar.i18n.ru-RU.json" />
    <EmbeddedResource Include="i18n/zh-CN.json" LogicalName="WinSidebar.i18n.zh-CN.json" />
  </ItemGroup>
</Project>
